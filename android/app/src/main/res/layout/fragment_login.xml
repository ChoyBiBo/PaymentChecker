<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F9FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Gradient hero header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_header"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="56dp"
            android:paddingBottom="40dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/announcement_card_bg"
                android:text="🏠"
                android:textSize="36sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOA Connect"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to continue"
                android:textSize="14sp"
                android:textColor="#B2E0E8"
                android:gravity="center"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Login card (overlaps header) -->
        <LinearLayout
            android:id="@+id/ll_login_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:padding="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="-20dp"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#5A7A84"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Enter username"
                android:textSize="15sp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#5A7A84"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Enter password"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="#DC2626"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Sign In"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#16A34A"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_version_tap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0"
            android:textSize="11sp"
            android:textColor="#C0D0D4"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/ll_demo_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/rounded_card"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRY A DEMO ACCOUNT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2A9DB5"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore the app without creating an account"
                android:textSize="12sp"
                android:textColor="#5A7A84"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_demo_homeowner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Demo as Homeowner"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#3E9142"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_demo_guard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Demo as Guard"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#D97706" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
