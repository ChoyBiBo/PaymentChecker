<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F9FB">

    <!-- Gradient Header with embedded announcement -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="20dp">

        <!-- User row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning"
                    android:textColor="#B2E0E8"
                    android:textSize="11sp"
                    android:letterSpacing="0.03" />

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Homeowner"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B2E0E8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Out"
                android:textColor="#B2E0E8"
                android:textSize="12sp"
                android:background="@drawable/announcement_card_bg"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Announcement card (ViewFlipper inside frosted card) -->
        <ViewFlipper
            android:id="@+id/vf_announcements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:autoStart="true"
            android:flipInterval="5000"
            android:inAnimation="@android:anim/slide_in_left"
            android:outAnimation="@android:anim/slide_out_right"
            android:background="@drawable/announcement_card_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📢  ANNOUNCEMENTS"
                    android:textColor="#7DD3E8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading announcements..."
                    android:textColor="#B2E0E8"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </ViewFlipper>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Payment Status Card -->
            <LinearLayout
                android:id="@+id/card_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card"
                android:padding="16dp"
                android:elevation="3dp"
                android:layout_marginBottom="10dp">

                <!-- Title + badge row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Payment Status"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#1A3A4A" />

                    <TextView
                        android:id="@+id/tv_payment_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAID"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="#16A34A"
                        android:background="@drawable/pill_badge_green" />
                </LinearLayout>

                <!-- Payment detail + date -->
                <TextView
                    android:id="@+id/tv_payment_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_paid_at"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#5A7A84"
                    android:layout_marginBottom="14dp" />

                <!-- PAID state: single green stat (months behind = 0) -->
                <LinearLayout
                    android:id="@+id/ll_stat_paid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_green"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_months_behind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#16A34A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Months Behind"
                            android:textSize="11sp"
                            android:textColor="#15803D"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You're all caught up!"
                            android:textSize="10sp"
                            android:textColor="#86EFAC"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- OVERDUE state: two red stats side by side -->
                <LinearLayout
                    android:id="@+id/ll_stat_overdue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_red"
                        android:padding="12dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_months_behind_overdue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#DC2626" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Months Behind"
                            android:textSize="11sp"
                            android:textColor="#991B1B"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_red"
                        android:padding="12dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:id="@+id/tv_total_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#DC2626" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unpaid Balance"
                            android:textSize="11sp"
                            android:textColor="#991B1B"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Submit proof button -->
                <TextView
                    android:id="@+id/btn_submit_proof"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Submit Payment Proof"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/rounded_button_teal"
                    android:padding="14dp" />

            </LinearLayout>

            <!-- Quick Access 2x2 Grid label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK ACCESS"
                android:textSize="10sp"
                android:textColor="#5A7A84"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Row 1: Amenities + Bookings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/card_amenities_quick"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/quick_access_card"
                    android:padding="12dp"
                    android:elevation="2dp"
                    android:layout_marginEnd="6dp">

                    <LinearLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stat_box_teal"
                        android:gravity="center"
                        android:layout_marginEnd="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏊"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Amenities"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A3A4A" />
                        <TextView
                            android:id="@+id/btn_view_amenities"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Book now →"
                            android:textColor="#2A9DB5"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_bookings_quick"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/quick_access_card"
                    android:padding="12dp"
                    android:elevation="2dp"
                    android:layout_marginStart="6dp">

                    <LinearLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stat_box_teal"
                        android:gravity="center"
                        android:layout_marginEnd="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bookings"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A3A4A" />
                        <TextView
                            android:id="@+id/btn_view_my_bookings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My requests →"
                            android:textColor="#2A9DB5"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Vehicles + Renovation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/card_vehicles_quick"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/quick_access_card"
                    android:padding="12dp"
                    android:elevation="2dp"
                    android:layout_marginEnd="6dp">

                    <LinearLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stat_box_teal"
                        android:gravity="center"
                        android:layout_marginEnd="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚗"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehicles"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A3A4A" />
                        <TextView
                            android:id="@+id/btn_view_vehicles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manage →"
                            android:textColor="#2A9DB5"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_renovation_quick"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/quick_access_card"
                    android:padding="12dp"
                    android:elevation="2dp"
                    android:layout_marginStart="6dp">

                    <LinearLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stat_box_teal"
                        android:gravity="center"
                        android:layout_marginEnd="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏠"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Renovation"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A3A4A" />
                        <TextView
                            android:id="@+id/btn_view_renovation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apply →"
                            android:textColor="#2A9DB5"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Hidden legacy containers kept for Kotlin compatibility -->
            <LinearLayout
                android:id="@+id/ll_amenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_my_requests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_vehicle_circles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
